  <vhdl appearance="logisim_evolution" name="popcount13_7seg">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
-- seg(6 downto 0) = a,b,c,d,e,f,g; active high; common cathode.&#13;
-- A 13-bit vector has a population count between 0 and 13 (0x0 to 0xD).&#13;
entity popcount13_7seg is&#13;
    port (vt : in std_logic_vector(12 downto 0);&#13;
          en : in std_logic;&#13;
          seg : out std_logic_vector(6 downto 0));&#13;
end popcount13_7seg;&#13;
&#13;
architecture rtl of popcount13_7seg is&#13;
begin&#13;
    process(vt, en)&#13;
        variable count_ones : integer range 0 to 13;&#13;
    begin&#13;
        count_ones := 0;&#13;
        for i in vt'range loop&#13;
            if vt(i) = '1' then&#13;
                count_ones := count_ones + 1;&#13;
            end if;&#13;
        end loop;&#13;
        if en = '0' then&#13;
            seg &lt;= "0000000";&#13;
        else&#13;
            case count_ones is&#13;
                when 0  =&gt; seg &lt;= "1111110";&#13;
                when 1  =&gt; seg &lt;= "0110000";&#13;
                when 2  =&gt; seg &lt;= "1101101";&#13;
                when 3  =&gt; seg &lt;= "1111001";&#13;
                when 4  =&gt; seg &lt;= "0110011";&#13;
                when 5  =&gt; seg &lt;= "1011011";&#13;
                when 6  =&gt; seg &lt;= "1011111";&#13;
                when 7  =&gt; seg &lt;= "1110000";&#13;
                when 8  =&gt; seg &lt;= "1111111";&#13;
                when 9  =&gt; seg &lt;= "1111011";&#13;
                when 10 =&gt; seg &lt;= "1110111"; -- A&#13;
                when 11 =&gt; seg &lt;= "0011111"; -- b&#13;
                when 12 =&gt; seg &lt;= "1001110"; -- C&#13;
                when 13 =&gt; seg &lt;= "0111101"; -- d&#13;
                when others =&gt; seg &lt;= "0000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end rtl;&#13;
</vhdl>
